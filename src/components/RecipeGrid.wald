---
import RecipeCard from './RecipeCard.wald'
import type { RecipeSummary } from '../lib/recipes'
/** eager: zoveel kaarten bovenaan de pagina laden hun foto meteen (de eerste met voorrang) en
 *  schuiven niet binnen: onzichtbaar tot GSAP start zou het grootste element (LCP) vertragen. */
type Props = { recipes: RecipeSummary[], headingLevel?: 2 | 3, eager?: number, balanced?: boolean }
const { recipes, headingLevel = 3, eager = 0, balanced = false } = $$props
// Verdeel de kaarten over ruime rijen: tien kaarten worden 3 + 3 + 2 + 2,
// op een tablet twee per rij. Zo blijft er geen losse laatste kaart over.
const rowColumns = (max: number): number[] => {
  if (!recipes.length) return []
  const rows = Math.ceil(recipes.length / max)
  const base = Math.floor(recipes.length / rows)
  const extra = recipes.length % rows
  return Array.from({ length: rows }, (_, i) => Array(base + (i < extra ? 1 : 0)).fill(base + (i < extra ? 1 : 0))).flat()
}
const tabletColumns = balanced ? rowColumns(2) : []
const desktopColumns = balanced ? rowColumns(3) : []
const cellLayout = (index: number) => balanced
  // GSAP wist inline stijlen na de reveal. Data-attributen blijven wel behouden.
  ? renderTemplate` data-balanced-tablet="${tabletColumns[index]}" data-balanced-desktop="${desktopColumns[index]}"`
  : ''
const sizesFor = (index: number) => balanced
  ? `(min-width: 1024px) ${100 / desktopColumns[index]}vw, (min-width: 640px) ${100 / tabletColumns[index]}vw, 92vw`
  : undefined
// Byzantium 12-kolomsgrid: 12 kolommen op mobiel, 6 vanaf sm, 4 vanaf lg. data-cuisine,
// data-course, data-time, data-level en data-diet worden gebruikt door de filters op /recepten,
// data-search door /zoeken.
const dietOf = (tags: string[]) => {
  const lower = tags.map(tag => tag.toLowerCase())
  return lower.includes('vegan') ? 'vegan vegetarisch' : lower.includes('vegetarisch') ? 'vegetarisch' : ''
}
const priorityOf = (index: number) => index === 0 && eager > 0 ? 'high' : index < eager ? 'eager' : undefined
const cells = await Promise.all(recipes.map(async (recipe, index) =>
  renderTemplate`<div class="byz-col-span-12 byz-col-span-sm-6 byz-col-span-lg-4"${new SafeHtml(cellLayout(index))}${new SafeHtml(index < eager ? '' : ' data-reveal="card"')} data-cuisine="${recipe.cuisine?.slug ?? ''}" data-course="${recipe.course}" data-time="${recipe.totalTime}" data-level="${recipe.difficulty}" data-diet="${dietOf(recipe.tags)}" data-search="${recipe.searchText}">${new SafeHtml(await RecipeCard.render({ recipe, headingLevel, sizes: sizesFor(index), priority: priorityOf(index) }))}</div>`
))
---
<div class={balanced ? 'recipe-grid recipe-grid--balanced byz-grid byz-grid--12 byz-gap-lg' : 'recipe-grid byz-grid byz-grid--12 byz-gap-lg'}>{new SafeHtml(cells.join(''))}</div>

<style>
.recipe-grid--balanced {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--byz-space-6);

  & > div {
    min-width: 0;
    grid-column: span 12;
  }
  & > div .recipe-card {
    height: 100%;
    aspect-ratio: auto;
    flex-direction: column;
    align-items: stretch;
    background: var(--steva-bordeaux-donker);
  }
  & > div .recipe-card::after {
    display: none;
  }
  & > div .recipe-card .recipe-card__image {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
  }
  & > div .recipe-card .recipe-card__text {
    padding: var(--byz-space-5);
  }
  & > div .recipe-card .recipe-card__title {
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
    line-height: 1.35;
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
    text-wrap: pretty;
  }
}
@media (min-width: 640px) {
  .recipe-grid--balanced {
    & > div[data-balanced-tablet="2"] { grid-column: span 6; }
  }
}
@media (min-width: 1024px) {
  .recipe-grid--balanced {
    & > div[data-balanced-desktop="1"] { grid-column: span 12; }
    & > div[data-balanced-desktop="2"] { grid-column: span 6; }
    & > div[data-balanced-desktop="3"] { grid-column: span 4; }
  }
}
/* Figma: 40px tussen de kaarten; de gap-schaal van Byzantium stopt bij xl (2rem). */
@media (min-width: 1024px) {
  .recipe-grid:not(.recipe-grid--balanced) {
    gap: var(--byz-space-10);
  }
}
</style>
