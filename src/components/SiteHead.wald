---
import { getSiteSettings } from '../lib/cms'
import { absoluteUrl, siteUrl, socialProfiles, type PageMeta } from '../lib/site'
import { readFileSync } from 'node:fs'
type Props = { page: PageMeta }
const { page } = $$props
const site = await getSiteSettings()
const siteName = site?.siteName || "Steva's Kookboek"

// Titel: "<pagina> | <site>" — of het titel-suffix uit Centaur als dat is ingevuld. Zonder
// merknaam in de titel herkent niemand in Google of in een browsertab van wie de pagina is.
const pageTitle = page.title || siteName
const suffix = site?.titleSuffix || `| ${siteName}`
const title = page.fullTitle || pageTitle === siteName ? pageTitle : `${pageTitle} ${suffix}`

// Canonical: uit Centaur als die is ingevuld, anders de eigen URL van de pagina. Absoluut zodra
// SITE_URL (of op Vercel het productiedomein) bekend is.
const canonical = page.canonicalUrl || (page.path ? absoluteUrl(page.path) : '')
const ogImage = page.ogImage || site?.defaultOgImageUrl || '/images/og-default.jpg'
const meta: Array<[attr: 'name' | 'property', key: string, content: string | null | undefined]> = [
  ['name', 'description', page.description],
  ['name', 'robots', page.noindex ? 'noindex, follow' : ''],
  ['property', 'og:type', page.type ?? 'website'],
  ['property', 'og:site_name', siteName],
  ['property', 'og:locale', 'nl_NL'],
  ['property', 'og:url', canonical],
  ['property', 'og:title', page.ogTitle || pageTitle],
  ['property', 'og:description', page.ogDescription || page.description],
  ['property', 'og:image', absoluteUrl(ogImage)],
  ['property', 'og:image:alt', page.ogImageAlt || pageTitle],
  ['name', 'twitter:card', 'summary_large_image']
]
const headTags = [
  ...meta
    .filter(([, , content]) => content)
    .map(([attr, key, content]) => renderTemplate`<meta ${new SafeHtml(attr)}="${key}" content="${content}">`),
  site?.faviconUrl ? renderTemplate`<link rel="icon" href="${site.faviconUrl}">` : '<link rel="icon" href="/images/favicon.png" type="image/png">',
  canonical ? renderTemplate`<link rel="canonical" href="${canonical}">` : ''
].join('\n    ')

// JSON-LD blijft in <head> (data-wald-no-hoist); "<" escapen zodat CMS-tekst nooit een
// </script> kan vormen. Organization op elke pagina, WebSite alleen op de homepage, plus wat
// de pagina zelf meegeeft. Google accepteert geen SVG als logo, vandaar de PNG.
const sameAs = Object.values(socialProfiles(site)).filter(Boolean)
const origin = siteUrl()
const schema: Record<string, unknown>[] = [
  {
    '@type': site?.schemaType || 'Organization',
    name: siteName,
    ...(origin ? { url: `${origin}/` } : {}),
    logo: absoluteUrl(site?.logoUrl || '/images/logo-512.png'),
    ...(sameAs.length ? { sameAs } : {})
  },
  ...(page.path === '/' ? [{ '@type': 'WebSite', name: siteName, inLanguage: 'nl', ...(origin ? { url: `${origin}/` } : {}) }] : []),
  ...(page.schema ?? [])
]
const jsonLd = `<script type="application/ld+json" data-wald-no-hoist>${JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schema
}).replace(/</g, '\\u003c')}</script>`

// Byzantium (tokens, reset, utilities) en motion.css zijn klein: inline in <head> in plaats van
// twee stylesheets die elk de eerste paint blokkeren. byzantium.css wordt door wald.config.ts
// gecompileerd vóór de pagina's renderen. "</" escapen, zodat de CSS de <style> niet kan sluiten.
const inlineCss = `<style data-wald-no-hoist>${[readFileSync('public/vendor/byzantium.css', 'utf8'), readFileSync('public/motion.css', 'utf8')].join('\n').replace(/<\//g, '<\\/')}</style>`

// Beweging (public/motion.css + motion.js met GSAP). html.motion verbergt binnenschuivende blokken
// tot het script ze toont; staat het script na 3 s nog niet aan (niet geladen, fout), dan gaat de
// klasse eraf en is alles gewoon zichtbaar. Scripts met defer: ze blokkeren de eerste paint niet.
// Als string (data-wald-no-hoist), zodat het inline stukje vóór de eerste paint in <head> draait.
const motionHead = `<script data-wald-no-hoist>document.documentElement.classList.add('motion');setTimeout(function(){window.__stevaMotion||document.documentElement.classList.remove('motion')},3000)</script>
    <script src="/vendor/gsap.min.js" defer data-wald-no-hoist></script>
    <script src="/vendor/ScrollTrigger.min.js" defer data-wald-no-hoist></script>
    <script src="/motion.js" defer data-wald-no-hoist></script>`

// Vercel Web Analytics (cookieloos): inject() laadt /_vercel/insights/script.js, dat Vercel alleen
// op de gedeployde site serveert. Niet op localhost, anders vult de console zich met 404's.
const analyticsHead = `<script type="module" data-wald-no-hoist>if (!/^(localhost|127\\.0\\.0\\.1)$/.test(location.hostname)) import('/vendor/vercel-analytics.mjs').then(function (m) { m.inject() })</script>`

// Lettertypes zelf gehost (public/fonts, beide OFL, overgenomen van Google Fonts): geen
// blokkerende stylesheet van een andere server meer. Fraunces is variabel (gewicht 400–600, opsz).
// Alleen het Latijnse deel wordt vooraf geladen; latin-ext (ł, ő, …) pas als een pagina het nodig heeft.
const fontHead = `<link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style data-wald-no-hoist>
      @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: 'Marck Script'; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/marck-script-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    </style>`
---
<title>{title}</title>
{new SafeHtml(headTags)}
{new SafeHtml(jsonLd)}
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
{new SafeHtml(inlineCss)}
<link rel="stylesheet" href="/print.css" media="print" />
{new SafeHtml(motionHead)}
{new SafeHtml(analyticsHead)}
{new SafeHtml(fontHead)}
