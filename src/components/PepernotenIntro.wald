---
type Props = { count: number }
const { count } = $$props
---
<header class="pepernoten-intro">
  <div class="pepernoten-intro__text">
    <p class="pepernoten-intro__kicker">Traditioneel, maar top!</p>
    <h1 class="pepernoten-intro__title">Zelf pepernoten maken</h1>
    <p class="pepernoten-intro__lead">Sint komt aan. De oven mag aan. Van klassieke roomboter tot pandan-kokos en pumpkin spice: ontdek {count} smaken om zelf te bakken en samen te delen.</p>
    <a class="pepernoten-intro__button" href="#smaken">Kies jouw smaak ↓</a>
    <p class="pepernoten-intro__note">Rond en knapperig? Dan zijn het eigenlijk kruidnoten. Hier vind je de koekjes die we vaak pepernoten noemen.</p>
  </div>
  <img class="pepernoten-intro__image" src="/images/pepernoten/strooizak.webp" alt="Een juten strooizak vol verschillende smaken kruidnoten naast een rode mijter" width="1254" height="1254" fetchpriority="high" />
</header>

<style>
.pepernoten-intro {
  display: grid;
  align-items: center;
  gap: var(--byz-space-8);
  padding: var(--byz-space-12) 0;
  margin-bottom: var(--byz-space-8);
}
.pepernoten-intro__kicker {
  font-family: var(--steva-font-script);
  font-size: var(--byz-text-2xl);
  color: var(--steva-goud);
}
.pepernoten-intro__title {
  margin: var(--byz-space-2) 0 var(--byz-space-6);
  font-size: clamp(2.25rem, 4.8vw, 4.5rem);
  font-weight: var(--byz-font-semibold);
  line-height: 1.1;
  text-transform: uppercase;
  text-wrap: balance;
}
.pepernoten-intro__lead {
  max-width: 47ch;
  font-size: var(--byz-text-lg);
  line-height: var(--byz-leading-relaxed);
}
.pepernoten-intro__button {
  display: inline-block;
  margin-top: var(--byz-space-8);
  padding: var(--byz-space-4) var(--byz-space-6);
  color: var(--steva-bordeaux-donker);
  background: var(--steva-goud);
  border-radius: var(--byz-space-2);
  font-weight: var(--byz-font-semibold);
  text-decoration: none;
}
.pepernoten-intro__button:hover { background: var(--steva-creme); }
.pepernoten-intro__note {
  max-width: 49ch;
  margin-top: var(--byz-space-6);
  color: var(--byz-color-text-muted);
  font-size: var(--byz-text-sm);
  line-height: var(--byz-leading-relaxed);
}
.pepernoten-intro__image {
  display: block;
  width: 100%;
  height: auto;
  max-width: 32rem;
  justify-self: center;
  filter: drop-shadow(0 16px 30px rgb(30 3 0 / .25));
}
@media (min-width: 768px) {
  .pepernoten-intro { grid-template-columns: 1.1fr 1fr; }
}
@media (max-width: 767px) {
  .pepernoten-intro { text-align: center; }
  .pepernoten-intro__lead, .pepernoten-intro__note { margin-inline: auto; }
  .pepernoten-intro__image { max-width: 23rem; }
}
</style>
