---
type Props = { enabled: boolean, text: string, analyticsId: string, metaPixelId?: string }
const { enabled, text, analyticsId, metaPixelId = '' } = $$props
const bannerEnabled = enabled || Boolean(metaPixelId)
const bannerText = [text || 'We gebruiken cookies. Je kiest zelf welke cookies je toestaat.', metaPixelId ? 'Met jouw toestemming gebruiken we ook Meta (Facebook en Instagram) voor marketing.' : ''].filter(Boolean).join(' ')
---
<div class="cms-cookie-banner" role="region" aria-label="Cookies" data-enabled={String(bannerEnabled)} data-analytics-id={analyticsId} data-meta-pixel-id={metaPixelId} hidden>
  <p class="cms-cookie-banner__text">{bannerText}</p>
  <div class="cms-cookie-banner__actions">
    <button type="button" class="cms-cookie-banner__secondary" data-cookie-preferences>Voorkeuren</button>
    <button type="button" class="cms-cookie-banner__secondary" data-cookie-choice="none">Alleen noodzakelijk</button>
    <button type="button" class="cms-cookie-banner__primary" data-cookie-choice="all">Alles accepteren</button>
  </div>
</div>

<dialog class="cms-cookie-dialog" aria-labelledby="cookie-voorkeuren-titel">
  <form method="dialog" class="cms-cookie-dialog__form">
    <h2 id="cookie-voorkeuren-titel" class="cms-cookie-dialog__title">Cookievoorkeuren</h2>
    <p class="cms-cookie-dialog__intro">Kies welke cookies we mogen gebruiken. Je kunt dit later altijd wijzigen via "Cookievoorkeuren" onderaan de pagina.</p>
    <label class="cms-cookie-dialog__option">
      <input type="checkbox" checked disabled />
      <span>
        <strong>Noodzakelijk</strong>
        <small>Nodig om de site te laten werken en je cookiekeuze te onthouden. Altijd aan.</small>
      </span>
    </label>
    <label class="cms-cookie-dialog__option">
      <input type="checkbox" name="analytics" />
      <span>
        <strong>Statistieken</strong>
        <small>Laat ons anoniem zien welke recepten en pagina's het meest bekeken worden, zodat we de site kunnen verbeteren.</small>
      </span>
    </label>
    <label class="cms-cookie-dialog__option" hidden>
      <input type="checkbox" name="marketing" />
      <span>
        <strong>Marketing</strong>
        <small>Meta (Facebook en Instagram) helpt ons advertentieresultaten te meten en relevante advertenties te tonen.</small>
      </span>
    </label>
    <div class="cms-cookie-dialog__actions">
      <button type="button" class="cms-cookie-banner__secondary" data-cookie-choice="none">Alleen noodzakelijk</button>
      <button type="button" class="cms-cookie-banner__primary" data-cookie-save>Opslaan</button>
    </div>
  </form>
</dialog>

<script src="/cookie-consent.js" defer></script>

<style>
.cms-cookie-banner {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--byz-space-4) var(--byz-space-6);
  /* Boven de adresbalk/thuisbalk van iOS blijven (viewport-fit=cover in Layout.wald). */
  padding: var(--byz-space-5) var(--steva-pagina-marge) calc(var(--byz-space-5) + env(safe-area-inset-bottom));
  background: var(--steva-bordeaux-donker);
  box-shadow: 0 -8px 30px rgb(0 0 0 / 0.35), inset 0 1px 0 var(--byz-color-border);
  color: var(--byz-color-text-primary);
  z-index: var(--byz-z-overlay);
}
.cms-cookie-banner[hidden] {
  display: none;
}
.cms-cookie-banner__text {
  flex: 1 1 22rem;
  margin: 0;
  max-width: 60ch;
}
.cms-cookie-banner__actions,
.cms-cookie-dialog__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--byz-space-3);
}
/* Alle knoppen even groot en even goed te vinden: weigeren mag niet moeilijker zijn dan
   accepteren. */
.cms-cookie-banner__primary,
.cms-cookie-banner__secondary {
  flex: 1 1 auto;
  min-height: 2.75rem;
  padding: var(--byz-space-2) var(--byz-space-5);
  border: 0;
  border-radius: 0.5rem;
  font: inherit;
  font-weight: var(--byz-font-semibold);
  cursor: pointer;
}
.cms-cookie-banner__primary {
  background: var(--byz-color-accent);
  box-shadow: inset 0 -4px 0 var(--steva-oranje-donker);
  color: var(--steva-bordeaux-donker);
}
.cms-cookie-banner__primary:hover {
  background: var(--steva-oranje-donker);
}
.cms-cookie-banner__secondary {
  background: rgb(255 255 255 / 0.06);
  box-shadow: inset 0 0 0 1px var(--byz-color-border);
  color: var(--byz-color-text-primary);
}
.cms-cookie-banner__secondary:hover {
  box-shadow: inset 0 0 0 1px var(--byz-color-accent);
}

/* Voorkeurenvenster */
/* margin: auto centreert het venster; de reset van Byzantium (* { margin: 0 }) haalt dat weg. */
.cms-cookie-dialog {
  margin: auto;
  width: min(calc(100% - 2rem), 30rem);
  max-height: calc(100dvh - 2rem);
  padding: 0;
  border: 0;
  border-radius: 1rem;
  background: var(--steva-bordeaux-donker);
  box-shadow: 0 20px 60px rgb(0 0 0 / 0.5), inset 0 0 0 1px var(--byz-color-border);
  color: var(--byz-color-text-primary);
}
.cms-cookie-dialog::backdrop {
  background: rgb(20 3 0 / 0.6);
}
.cms-cookie-dialog__form {
  display: grid;
  gap: var(--byz-space-5);
  padding: var(--byz-space-8) var(--byz-space-6) var(--byz-space-6);
}
.cms-cookie-dialog__title {
  margin: 0;
  font-size: var(--byz-text-xl);
  font-weight: var(--byz-font-semibold);
  text-transform: uppercase;
}
.cms-cookie-dialog__intro {
  margin: 0;
  color: var(--byz-color-text-secondary);
  font-size: var(--byz-text-sm);
}
.cms-cookie-dialog__option {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--byz-space-3);
  padding: var(--byz-space-4);
  border-radius: 0.75rem;
  background: rgb(255 255 255 / 0.04);
  box-shadow: inset 0 0 0 1px var(--byz-color-border);
  cursor: pointer;
}
.cms-cookie-dialog__option input {
  width: 1.25rem;
  height: 1.25rem;
  margin-top: 0.15rem;
  accent-color: var(--byz-color-accent);
  cursor: pointer;
}
.cms-cookie-dialog__option[hidden] {
  display: none;
}
.cms-cookie-dialog__option input:disabled {
  cursor: not-allowed;
}
.cms-cookie-dialog__option strong {
  display: block;
  margin-bottom: var(--byz-space-1);
}
.cms-cookie-dialog__option small {
  display: block;
  color: var(--byz-color-text-muted);
  font-size: var(--byz-text-sm);
  line-height: 1.45;
}
</style>
