---
import SearchIcon from './SearchIcon.wald'
type Props = { siteName: string, aboutHref?: string }
const { siteName, aboutHref = '' } = $$props
const aboutLink = aboutHref ? renderTemplate`<a href="${aboutHref}" wald:prefetch="hover">Over Steva</a>` : ''
const aboutMenuLink = aboutHref ? renderTemplate`<a href="${aboutHref}">Over Steva</a>` : ''
---
<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={siteName || 'Home'}>
      <img src="/logo-steva.svg" alt="" width="194" height="65" class="site-header__logo" />
    </a>
    <nav class="site-header__nav" aria-label="Hoofdnavigatie">
      <a href="/recepten" wald:prefetch="hover">Recepten</a>
      <a href="/keukens" wald:prefetch="hover">Keukens</a>
      <a href="/inspiratie" wald:prefetch="hover">Inspiratie</a>
      <a href="/recept-insturen" wald:prefetch="hover">Recept insturen</a>
      {new SafeHtml(aboutLink)}
    </nav>
    <details class="site-header__menu">
      <summary aria-label="Menu">
        <span class="site-header__menu-icon" aria-hidden="true"></span>
        Menu
      </summary>
      <nav class="site-header__menu-nav" aria-label="Hoofdnavigatie (mobiel)">
        <a href="/recepten">Recepten</a>
        <a href="/keukens">Keukens</a>
        <a href="/inspiratie">Inspiratie</a>
        <a href="/recept-insturen">Recept insturen</a>
        {new SafeHtml(aboutMenuLink)}
      </nav>
    </details>
    <a href="/zoeken" class="site-header__search">
      <SearchIcon size={18} />
      <span class="site-header__search-label">Zoeken</span>
    </a>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: var(--byz-z-sticky);
  background: rgb(140 35 14 / 0.25);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--byz-space-8);
  max-width: var(--steva-pagina-breedte);
  min-height: 6rem;
  margin: 0 auto;
  padding: 0 var(--steva-pagina-marge);
}
.site-header__brand {
  display: block;
  flex-shrink: 0;
}
.site-header__logo {
  display: block;
  width: 12.125rem;
  height: auto;
}
.site-header__nav {
  display: flex;
  flex: 1;
  justify-content: flex-end;
  gap: var(--byz-space-6);
}
/* "Over Steva" is optioneel en in de frontmatter opgebouwd (zonder scope-attribuut): genest. */
.site-header__nav {
  & a {
    color: var(--byz-color-text-secondary);
    font-size: 1rem;
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & a:hover {
    color: var(--byz-color-text-primary);
  }
}
.site-header__search:active {
  box-shadow: inset 0 -1px 0 var(--steva-oranje-donker), inset 0 2px 4px rgb(67 11 0 / 0.35);
  transform: translateY(3px);
}
.site-header__search {
  display: inline-flex;
  align-items: center;
  gap: var(--byz-space-2);
  padding: var(--byz-space-2) var(--byz-space-4);
  border-radius: 0.5rem;
  background: var(--byz-color-accent);
  box-shadow: inset 0 -4px 0 var(--steva-oranje-donker), 0 2px 8px var(--steva-bordeaux-rand);
  color: var(--steva-bordeaux-donker);
  font-size: 1rem;
  font-weight: var(--byz-font-semibold);
  line-height: 1.5rem;
  text-transform: uppercase;
  text-decoration: none;
}
.site-header__search:hover {
  filter: brightness(1.06);
}
/* Mobiel menu: <details>/<summary> werkt zonder JavaScript en is toetsenbord-toegankelijk.
   Alleen zichtbaar als de gewone navigatie verdwijnt (≤ 960px). */
.site-header__menu {
  display: none;
  position: relative;
  margin-left: auto;
}
.site-header__menu summary {
  display: flex;
  align-items: center;
  gap: var(--byz-space-2);
  padding: var(--byz-space-2) var(--byz-space-3);
  border-radius: 0.5rem;
  color: var(--byz-color-text-secondary);
  font-weight: var(--byz-font-semibold);
  text-transform: uppercase;
  text-shadow: var(--steva-tekst-schaduw);
  list-style: none;
  cursor: pointer;
}
.site-header__menu summary::-webkit-details-marker {
  display: none;
}
.site-header__menu-icon,
.site-header__menu-icon::before,
.site-header__menu-icon::after {
  display: block;
  width: 1.125rem;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
}
.site-header__menu-icon {
  position: relative;
}
.site-header__menu-icon::before,
.site-header__menu-icon::after {
  content: "";
  position: absolute;
  left: 0;
}
.site-header__menu-icon::before {
  top: -6px;
}
.site-header__menu-icon::after {
  top: 6px;
}
.site-header__menu-nav {
  position: absolute;
  top: calc(100% + var(--byz-space-2));
  right: 0;
  display: flex;
  flex-direction: column;
  min-width: 13rem;
  padding: var(--byz-space-2);
  border-radius: 0.625rem;
  background: var(--steva-bordeaux-donker);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.4), inset 0 0 0 1px var(--byz-color-border);
}
/* "Over Steva" is optioneel en in de frontmatter opgebouwd (zonder scope-attribuut): genest. */
.site-header__menu-nav {
  & a {
    padding: var(--byz-space-3) var(--byz-space-4);
    border-radius: 0.375rem;
    color: var(--byz-color-text-secondary);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    text-decoration: none;
  }
  & a:hover {
    background: rgb(255 174 61 / 0.15);
    color: var(--byz-color-text-primary);
  }
}
@media (max-width: 640px) {
  /* Logo + menu + zoekknop passen anders niet naast elkaar op een telefoon:
     de zoekknop wordt een icoon, het label blijft voor schermlezers. */
  .site-header__inner {
    gap: var(--byz-space-3);
  }
  .site-header__search {
    padding: var(--byz-space-2) var(--byz-space-3);
  }
  .site-header__search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
}
@media (max-width: 960px) {
  .site-header__nav {
    display: none;
  }
  .site-header__menu {
    display: block;
  }
  .site-header__logo {
    width: 9rem;
  }
}
@media (max-width: 360px) {
  .site-header__inner {
    gap: var(--byz-space-2);
  }
}
</style>
