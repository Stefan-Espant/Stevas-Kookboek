---
/** Liggende fototegel met titel en ondertitel, voor keukens en inspiratie-thema's. */
type Props = { href: string, title: string, subtitle: string, image?: string }
const { href, title, subtitle, image = '' } = $$props
// Zelfde placeholder als RecipeCard wanneer er geen foto is.
const imageHtml = image
  ? renderTemplate`<img src="${image}" alt="" loading="lazy" class="tile-card__image">`
  : '<div class="tile-card__image tile-card__image--placeholder"><img src="/logo-steva.svg" alt=""></div>'
---
<a href={href} class="tile-card" wald:prefetch="visible">
  {new SafeHtml(imageHtml)}
  <span class="tile-card__text">
    <span class="tile-card__name">{title}</span>
    <span class="tile-card__count">{subtitle}</span>
  </span>
</a>

<style>
/* Variant van RecipeCard: liggend, met een titel en een korte ondertitel (keukens, thema's). */
.tile-card {
  position: relative;
  display: flex;
  align-items: flex-end;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 0.625rem;
  background: var(--byz-color-surface);
  box-shadow: 8px 8px 16px rgb(0 0 0 / 0.25);
  text-decoration: none;
  transition: transform var(--byz-duration-normal) var(--byz-ease-default);

  & .tile-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--byz-duration-slow) var(--byz-ease-out);
  }
  & .tile-card__image--placeholder {
    display: grid;
    place-items: center;
    padding-bottom: 20%;
    background: url("/images/hero-textuur.webp") center / cover, var(--byz-color-surface);
    background-blend-mode: multiply, normal;
  }
  & .tile-card__image--placeholder img {
    width: 45%;
    opacity: 0.85;
  }
}
.tile-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgb(67 11 0 / 0.85), rgb(67 11 0 / 0) 55%);
}
.tile-card:hover {
  transform: translateY(-4px);

  & .tile-card__image {
    transform: scale(1.03);
  }
}
.tile-card__text {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: var(--byz-space-1);
  padding: 0 var(--byz-space-8) var(--byz-space-6);
}
.tile-card__name {
  color: var(--byz-color-text-primary);
  font-size: var(--byz-text-2xl);
  font-weight: var(--byz-font-semibold);
  line-height: 1.2;
  text-transform: uppercase;
  text-shadow: var(--steva-tekst-schaduw);
}
.tile-card__count {
  color: var(--byz-color-accent);
  font-family: var(--steva-font-script);
  font-size: var(--byz-text-lg);
  text-shadow: var(--steva-tekst-schaduw);
}
</style>
