---
/** Zichtbaar kruimelpad; geef dezelfde items mee aan breadcrumbSchema() voor Google. */
type Props = { items: Array<[name: string, path: string]> }
const { items } = $$props
// Het laatste item is de huidige pagina: geen link, wel aria-current.
const itemsHtml = items
  .map(([name, path], index) => index === items.length - 1
    ? renderTemplate`<li><span aria-current="page">${name}</span></li>`
    : renderTemplate`<li><a href="${path}">${name}</a></li>`)
  .join('')
---
<nav class="breadcrumbs" aria-label="Kruimelpad">
  <ol>{new SafeHtml(itemsHtml)}</ol>
</nav>

<style>
/* De items zijn in de frontmatter opgebouwd — genest onder de gescopete nav. */
.breadcrumbs {
  margin-bottom: var(--byz-space-6);
  font-size: var(--byz-text-sm);

  & ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--byz-space-1) var(--byz-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  & li {
    display: flex;
    align-items: center;
    gap: var(--byz-space-2);
    min-width: 0;
  }
  & li + li::before {
    content: "›";
    color: var(--byz-color-text-muted);
  }
  & a {
    color: var(--byz-color-text-secondary);
    text-decoration: none;
  }
  & a:hover {
    color: var(--byz-color-text-primary);
    text-decoration: underline;
  }
  & [aria-current] {
    overflow: hidden;
    color: var(--byz-color-text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}
</style>
