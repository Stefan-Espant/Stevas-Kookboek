---
/** Lopende band met alle keukens, als een linnen lint met gestikte randen. */
type Props = { cuisines: Array<{ slug: string, name: string }> }
const { cuisines } = $$props
const items = (decorative: boolean) => cuisines
  .map(c => decorative
    ? renderTemplate`<li><a href="/keukens/${c.slug}" tabindex="-1">${c.name}</a></li>`
    : renderTemplate`<li><a href="/keukens/${c.slug}">${c.name}</a></li>`)
  .join('')
// Twee keer dezelfde lijst achter elkaar: de band schuift precies één lijst op en begint dan
// naadloos opnieuw. De kopie is voor schermlezers en toetsenbord onzichtbaar.
const listHtml = cuisines.length
  ? `<ul class="marquee__list">${items(false)}</ul><ul class="marquee__list" aria-hidden="true">${items(true)}</ul>`
  : ''
---
<div class="marquee-clip">
  <nav class="marquee" aria-label="Keukens">
    <div class="marquee__track">{new SafeHtml(listHtml)}</div>
  </nav>
  <button type="button" class="marquee__toggle" aria-pressed="false" hidden>Pauzeer de band</button>
</div>

<script>
// WCAG 2.2.2: bewegende inhoud moet je kunnen stilzetten. Alleen tonen als de band beweegt.
document.querySelectorAll('.marquee-clip').forEach(function (clip) {
  var button = clip.querySelector('.marquee__toggle')
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
  button.hidden = false
  button.addEventListener('click', function () {
    var paused = button.getAttribute('aria-pressed') !== 'true'
    button.setAttribute('aria-pressed', String(paused))
    button.textContent = paused ? 'Speel de band af' : 'Pauzeer de band'
    clip.classList.toggle('is-paused', paused)
  })
})
</script>

<style>
/* De band staat schuin en zou daardoor buiten het scherm uitsteken: horizontaal afknippen. */
.marquee-clip {
  position: relative;
  overflow-x: clip;
  margin: var(--byz-space-16) 0 var(--byz-space-20);
  padding: var(--byz-space-4) 0;
}
/* De lijsten zijn in de frontmatter opgebouwd — genest onder de gescopete nav. */
.marquee {
  position: relative;
  overflow: hidden;
  padding: var(--byz-space-4) 0;
  /* Linnen lint: geweven textuur met gestikte randen boven en onder. */
  background:
    repeating-linear-gradient(90deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(0deg, rgb(0 0 0 / 0.06) 0 1px, transparent 1px 3px),
    linear-gradient(180deg, var(--steva-bordeaux-licht), var(--steva-bordeaux-rand));
  box-shadow: 0 6px 16px rgb(0 0 0 / 0.3), inset 0 1px 0 rgb(255 255 255 / 0.08);
  transform: rotate(-1.2deg);
  /* Zachte randen links en rechts. */
  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);

  &::before,
  &::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1.5px dashed rgb(255 196 113 / 0.55);
  }
  &::before {
    top: 6px;
  }
  &::after {
    bottom: 6px;
  }
  & .marquee__track {
    display: flex;
    width: max-content;
  }
  & .marquee__list {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  & li {
    display: flex;
    align-items: center;
  }
  /* Ruitje tussen de namen. */
  & li::after {
    content: "✦";
    margin: 0 var(--byz-space-6);
    color: var(--byz-color-accent);
    font-size: var(--byz-text-sm);
  }
  & a {
    color: var(--steva-goud);
    font-family: var(--steva-font-script);
    font-size: var(--byz-text-2xl);
    line-height: 1.2;
    text-decoration: none;
    text-shadow: var(--steva-tekst-schaduw);
    white-space: nowrap;
  }
  & a:hover,
  & a:focus-visible {
    color: var(--steva-creme);
  }
}
.marquee__toggle {
  position: absolute;
  right: var(--steva-pagina-marge);
  bottom: calc(-1 * var(--byz-space-6));
  padding: var(--byz-space-1) var(--byz-space-3);
  border: 0;
  border-radius: 999px;
  background: rgb(67 11 0 / 0.7);
  box-shadow: inset 0 0 0 1px var(--byz-color-border);
  color: var(--byz-color-text-muted);
  font: inherit;
  font-size: var(--byz-text-xs);
  cursor: pointer;
}
.marquee__toggle[hidden] {
  display: none;
}
.marquee__toggle:hover {
  color: var(--byz-color-text-primary);
}
.marquee-clip.is-paused .marquee__track {
  animation-play-state: paused !important;
}
@media (prefers-reduced-motion: no-preference) {
  .marquee {
    & .marquee__track {
      animation: marquee-scroll 60s linear infinite;
    }
    /* Stil bij hover en zodra je er met het toetsenbord in zit. */
    &:hover .marquee__track,
    &:focus-within .marquee__track {
      animation-play-state: paused;
    }
  }
}
/* Bij minder beweging: geen lopende band maar horizontaal scrollen, zonder de kopie. */
@media (prefers-reduced-motion: reduce) {
  .marquee {
    overflow-x: auto;

    & .marquee__list[aria-hidden] {
      display: none;
    }
  }
}
@keyframes marquee-scroll {
  to { transform: translateX(-50%); }
}
</style>
