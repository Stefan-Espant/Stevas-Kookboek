---
import Layout from '../../layouts/Layout.wald'
import PageHeader from '../../components/PageHeader.wald'
import RecipeGrid from '../../components/RecipeGrid.wald'
import { getAllRecipes, getCuisines, recipePath } from '../../lib/recipes'
import { breadcrumbSchema, clipDescription, collectionSchema } from '../../lib/site'
const [recipes, cuisines] = await Promise.all([getAllRecipes(), getCuisines()])
const lead = `${recipes.length} ${recipes.length === 1 ? 'recept' : 'recepten'} uit keukens van over de hele wereld.`
const description = clipDescription(`Alle recepten van Steva's Kookboek, uit keukens van over de hele wereld: ${recipes.map(r => r.title).join(', ')}.`)
const schema = [
  breadcrumbSchema([['Home', '/'], ['Recepten', '/recepten']]),
  collectionSchema('Alle recepten', description, '/recepten', recipes.map(r => [r.title, recipePath(r.slug)]))
]

// Keukenfilter: knoppen alleen tonen als er meer dan één keuken is. Verborgen tot het
// script draait, zodat je zonder JavaScript gewoon alle recepten ziet.
const filterHtml = cuisines.length > 1
  ? renderTemplate`<div class="recipes__filter" role="group" aria-label="Filter op keuken" hidden>
      <button type="button" data-cuisine="" aria-pressed="true">Alle</button>
      ${new SafeHtml(cuisines.map(cuisine => renderTemplate`<button type="button" data-cuisine="${cuisine.slug}" aria-pressed="false">${cuisine.name}</button>`).join(''))}
    </div>`
  : ''
const gridHtml = recipes.length
  ? await RecipeGrid.render({ recipes, headingLevel: 2 })
  : '<p class="recipes__empty">Binnenkort verschijnen hier de eerste recepten!</p>'
---
<Layout title="Alle recepten" description={description} path="/recepten" schema={schema}>
  <main class="recipes">
    <PageHeader kicker="Recepten" title="Alle recepten" lead={lead} />
    {new SafeHtml(filterHtml)}
    {new SafeHtml(gridHtml)}
  </main>
</Layout>

<script>
document.querySelectorAll('.recipes__filter').forEach(function (filter) {
  var cells = document.querySelectorAll('.recipe-grid [data-cuisine]')
  filter.addEventListener('click', function (event) {
    var button = event.target.closest('button[data-cuisine]')
    if (!button) return
    var cuisine = button.dataset.cuisine
    filter.querySelectorAll('button').forEach(function (b) {
      b.setAttribute('aria-pressed', String(b === button))
    })
    cells.forEach(function (cell) {
      cell.hidden = cuisine !== '' && cell.dataset.cuisine !== cuisine
    })
  })
  filter.hidden = false
})
</script>

<style>
/* Filter en lege staat zijn conditioneel, dus in de frontmatter opgebouwd —
   genest onder de gescopete main (zie RecipeCard.wald). */
.recipes {
  max-width: var(--steva-pagina-breedte);
  margin: 0 auto;
  padding: var(--byz-space-12) var(--steva-pagina-marge) var(--byz-space-24);

  & .recipes__filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--byz-space-2);
    margin-bottom: var(--byz-space-12);
  }
  & .recipes__filter[hidden],
  & [data-cuisine][hidden] {
    display: none;
  }
  & .recipes__filter button {
    padding: var(--byz-space-2) var(--byz-space-5);
    border: 0;
    border-radius: 999px;
    background: rgb(67 11 0 / 0.55);
    box-shadow: inset 0 0 0 1px var(--byz-color-border);
    color: var(--byz-color-text-secondary);
    font-size: var(--byz-text-sm);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    cursor: pointer;
  }
  & .recipes__filter button[aria-pressed="true"] {
    background: var(--byz-color-accent);
    box-shadow: inset 0 -3px 0 var(--steva-oranje-donker);
    color: var(--steva-creme);
  }
  & .recipes__empty {
    color: var(--byz-color-text-secondary);
    font-family: var(--steva-font-script);
    font-size: var(--byz-text-xl);
    text-align: center;
  }
}
</style>
