---
import Layout from '../../layouts/Layout.wald'
import PageHeader from '../../components/PageHeader.wald'
import RecipeGrid from '../../components/RecipeGrid.wald'
import FeaturedRecipe from '../../components/FeaturedRecipe.wald'
import { collectionPath, getAllRecipes, getCollections, getCuisines, recipePath } from '../../lib/recipes'
import { breadcrumbSchema, clipDescription, collectionSchema } from '../../lib/site'
const [recipes, cuisines, collections] = await Promise.all([getAllRecipes(), getCuisines(), getCollections()])
const lead = `${recipes.length} ${recipes.length === 1 ? 'recept' : 'recepten'} uit keukens van over de hele wereld.`
const description = clipDescription(`Alle recepten van Steva's Kookboek, uit keukens van over de hele wereld: ${recipes.map(r => r.title).join(', ')}.`)
const schema = [
  breadcrumbSchema([['Home', '/'], ['Recepten', '/recepten']]),
  collectionSchema('Alle recepten', description, '/recepten', recipes.map(r => [r.title, recipePath(r.slug)]))
]

// Kerncijfers onder de kop.
const quick = recipes.filter(r => r.totalTime > 0 && r.totalTime <= 30).length
const stats = [
  [String(recipes.length), recipes.length === 1 ? 'recept' : 'recepten'],
  [String(cuisines.length), cuisines.length === 1 ? 'keuken' : 'keukens'],
  [String(quick), 'binnen 30 min']
]
const statsHtml = recipes.length
  ? renderTemplate`<dl class="recipes__stats">${new SafeHtml(stats.map(([value, label]) => renderTemplate`<div><dt>${label}</dt><dd data-count="${value}">${value}</dd></div>`).join(''))}</dl>`
  : ''

// Uitgelicht: het nieuwste recept met een foto (anders gewoon het nieuwste).
const featured = recipes.find(r => r.image) ?? recipes[0]
const featuredHtml = featured ? await FeaturedRecipe.render({ recipe: featured, kicker: 'Nieuw in het kookboek' }) : ''

// Thema's als horizontale strook; elk thema heeft een eigen pagina.
const themesHtml = collections.length
  ? renderTemplate`<section class="recipes__themes" aria-labelledby="themas">
      <div class="recipes__themes-sticky">
      <div class="recipes__section-head" data-reveal="left">
        <h2 id="themas" class="recipes__heading">Waar heb je zin in?</h2>
        <a href="/inspiratie" class="recipes__more">Alle thema's →</a>
      </div>
      <ul class="recipes__rail">${new SafeHtml(collections.map(c => renderTemplate`<li data-reveal><a href="${collectionPath(c.slug)}" class="recipes__theme">
        <span class="recipes__theme-count">${c.recipes.length}</span>
        <span class="recipes__theme-title">${c.title}</span>
        <span class="recipes__theme-text">${c.description}</span>
      </a></li>`).join(''))}</ul>
      </div>
    </section>`
  : ''

// Filters op gang, keuken, tijd, niveau en dieet, plus sorteren. Verborgen tot het script draait,
// zodat je zonder JavaScript gewoon alle recepten ziet. Elke keuze komt in de URL (deelbaar).
const LEVEL_ORDER = ['Makkelijk', 'Gemiddeld', 'Uitdagend']
const levels = [...new Set(recipes.map(r => r.difficulty).filter(Boolean))]
  .sort((a, b) => (LEVEL_ORDER.indexOf(a) + 1 || 99) - (LEVEL_ORDER.indexOf(b) + 1 || 99))
const option = (value: string, label: string) => renderTemplate`<option value="${value}">${label}</option>`
const select = (name: string, label: string, options: string) => renderTemplate`<label class="recipes__select">
          <span>${label}</span>
          <select name="${name}">${new SafeHtml(options)}</select>
        </label>`
const COURSE_ORDER = ['Brunch', 'Voorgerecht', 'Soep', 'Hoofdgerecht', 'Bijgerecht', 'Snack', 'Dessert']
const COURSE_LABEL: Record<string, string> = { Brunch: 'Ontbijt en brunch', Snack: 'Borrelhapjes' }
const courses = [...new Set(recipes.map(r => r.course).filter(Boolean))]
  .sort((a, b) => (COURSE_ORDER.indexOf(a) + 1 || 99) - (COURSE_ORDER.indexOf(b) + 1 || 99))
const filterHtml = recipes.length > 1 && (courses.length > 1 || cuisines.length > 1)
  ? renderTemplate`<div class="recipes__filters" hidden>
      <div class="recipes__bar">
        <button type="button" class="recipes__open" aria-haspopup="dialog" aria-controls="recepten-filters">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          Filters <span class="recipes__badge" hidden></span>
        </button>
        <p class="recipes__count" aria-live="polite"></p>
      </div>
      <div class="recipes__slot"><div class="recipes__panel">
      <div class="recipes__courses" role="group" aria-label="Filter op gang">
        <button type="button" data-course="" aria-pressed="true">Alles</button>
        ${new SafeHtml(courses.map(course => renderTemplate`<button type="button" data-course="${course}" aria-pressed="false">${COURSE_LABEL[course] ?? course}</button>`).join(''))}
      </div>
      <div class="recipes__selects">
        ${new SafeHtml(select('keuken', 'Keuken', option('', 'Alle keukens') + [...cuisines].sort((a, b) => a.name.localeCompare(b.name)).map(c => option(c.slug, `${c.name} (${c.recipes.length})`)).join('')))}
        ${new SafeHtml(select('tijd', 'Tijd', option('', 'Maakt niet uit') + option('15', 'Tot 15 minuten') + option('30', 'Tot 30 minuten') + option('60', 'Tot een uur') + option('lang', 'Langer dan een uur')))}
        ${new SafeHtml(levels.length > 1 ? select('niveau', 'Niveau', option('', 'Alle niveaus') + levels.map(level => option(level, level)).join('')) : '')}
        ${new SafeHtml(select('dieet', 'Dieet', option('', 'Alles') + option('vegetarisch', 'Vegetarisch') + option('vegan', 'Vegan')))}
        ${new SafeHtml(select('sorteer', 'Sorteren', option('', 'Nieuwste eerst') + option('snel', 'Snelste eerst') + option('az', 'Op naam (A–Z)')))}
      </div>
      </div></div>
      <div class="recipes__filter-row">
        <p class="recipes__count" aria-live="polite"></p>
        <button type="button" class="recipes__reset" data-reset hidden>Wis alle filters</button>
      </div>
    </div>
    <dialog class="recipes__drawer" id="recepten-filters" aria-labelledby="recepten-filters-titel">
      <div class="recipes__drawer-head">
        <h2 id="recepten-filters-titel" class="recipes__drawer-title">Filters</h2>
        <button type="button" class="recipes__close" aria-label="Filters sluiten">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="recipes__drawer-body"></div>
      <div class="recipes__drawer-foot">
        <button type="button" class="recipes__drawer-reset" data-reset>Wis alles</button>
        <button type="button" class="recipes__show">Toon recepten</button>
      </div>
    </dialog>`
  : ''
const gridHtml = recipes.length
  ? await RecipeGrid.render({ recipes, headingLevel: 3, eager: 1 })
  : '<p class="recipes__empty">Binnenkort verschijnen hier de eerste recepten!</p>'
const allHtml = recipes.length
  ? renderTemplate`<section class="recipes__all" aria-labelledby="alle-recepten">
      <div class="recipes__section-head" data-reveal="left">
        <h2 id="alle-recepten" class="recipes__heading">Blader door alles</h2>
      </div>
      ${new SafeHtml(filterHtml)}
      ${new SafeHtml(gridHtml)}
      <p class="recipes__none" hidden>Geen recepten met deze combinatie. <button type="button" data-reset>Wis de filters</button></p>
    </section>`
  : gridHtml
---
<Layout title="Alle recepten" description={description} path="/recepten" schema={schema}>
  <main class="recipes">
    <PageHeader kicker="Recepten" title="Alle recepten" lead={lead} />
    {new SafeHtml(statsHtml)}
    {new SafeHtml(featuredHtml)}
    {new SafeHtml(themesHtml)}
    {new SafeHtml(allHtml)}
  </main>
</Layout>

<script>
document.querySelectorAll('.recipes__filters').forEach(function (filters) {
  var section = filters.closest('.recipes__all')
  var grid = section.querySelector('.recipe-grid')
  var cells = [].slice.call(grid.querySelectorAll('[data-cuisine]'))
  var buttons = filters.querySelectorAll('button[data-course]')
  var selects = [].slice.call(filters.querySelectorAll('select'))
  var counts = section.querySelectorAll('.recipes__count')
  var reset = filters.querySelector('.recipes__reset')
  var none = section.querySelector('.recipes__none')
  // Mobiel: de filters (het paneel) verhuizen naar een drawer onderin; de knop "Filters" opent
  // hem. Een <dialog> als modal: focus blijft erin, Esc sluit, de rest van de pagina is inert.
  var drawer = section.querySelector('.recipes__drawer')
  var panel = filters.querySelector('.recipes__panel')
  var slot = filters.querySelector('.recipes__slot')
  var drawerBody = drawer.querySelector('.recipes__drawer-body')
  var openButton = filters.querySelector('.recipes__open')
  var badge = filters.querySelector('.recipes__badge')
  var showButton = drawer.querySelector('.recipes__show')
  var drawerReset = drawer.querySelector('.recipes__drawer-reset')
  var mobile = matchMedia('(max-width: 767px)')
  // Gang heet in de URL "gang"; de selects gebruiken hun eigen naam (keuken, tijd, niveau, …).
  var state = { gang: '' }
  selects.forEach(function (select) { state[select.name] = '' })
  var original = cells.slice()
  var titles = new Map(cells.map(function (cell) {
    var title = cell.querySelector('.recipe-card__title')
    return [cell, title ? title.textContent.trim() : '']
  }))

  function timeMatches(minutes, choice) {
    if (!choice) return true
    if (!minutes) return false
    return choice === 'lang' ? minutes > 60 : minutes <= Number(choice)
  }
  function matches(cell) {
    var d = cell.dataset
    return (!state.gang || d.course === state.gang) &&
      (!state.keuken || d.cuisine === state.keuken) &&
      timeMatches(Number(d.time), state.tijd) &&
      (!state.niveau || d.level === state.niveau) &&
      (!state.dieet || (' ' + d.diet + ' ').indexOf(' ' + state.dieet + ' ') !== -1)
  }
  function order() {
    if (state.sorteer === 'snel') {
      // Recepten zonder tijd achteraan.
      return original.slice().sort(function (a, b) { return (Number(a.dataset.time) || 1e6) - (Number(b.dataset.time) || 1e6) })
    }
    if (state.sorteer === 'az') {
      return original.slice().sort(function (a, b) { return titles.get(a).localeCompare(titles.get(b), 'nl') })
    }
    return original
  }

  function apply() {
    var shown = 0
    order().forEach(function (cell) {
      var match = matches(cell)
      cell.hidden = !match
      if (match) shown++
      grid.appendChild(cell)
    })
    buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.course === state.gang)) })
    selects.forEach(function (select) {
      select.value = state[select.name]
      select.classList.toggle('is-active', !!state[select.name])
    })
    var label = shown + (shown === 1 ? ' recept' : ' recepten')
    counts.forEach(function (count) { count.textContent = label })
    showButton.textContent = shown ? 'Toon ' + label : 'Geen recepten'
    none.hidden = shown > 0
    // Aantal actieve filters (sorteren telt niet mee) op de knop "Filters".
    var active = Object.keys(state).filter(function (key) { return key !== 'sorteer' && state[key] }).length
    badge.textContent = active
    badge.hidden = !active
    openButton.setAttribute('aria-label', active ? 'Filters, ' + active + ' actief' : 'Filters')
    reset.hidden = !Object.keys(state).some(function (key) { return state[key] })
    drawerReset.disabled = reset.hidden
    // Deelbare URL: /recepten?gang=Hoofdgerecht&tijd=30&dieet=vegetarisch
    var url = new URL(location.href)
    Object.keys(state).forEach(function (key) {
      state[key] ? url.searchParams.set(key, state[key]) : url.searchParams.delete(key)
    })
    history.replaceState(null, '', url)
    if (window.ScrollTrigger) window.ScrollTrigger.refresh()
  }
  function clear() {
    Object.keys(state).forEach(function (key) { state[key] = '' })
    apply()
  }

  // Op de sectie, niet op .recipes__filters: op mobiel staan de knoppen in de drawer.
  section.addEventListener('click', function (event) {
    var button = event.target.closest('button[data-course]')
    if (!button) return
    state.gang = button.dataset.course
    apply()
  })
  selects.forEach(function (select) {
    select.addEventListener('change', function () {
      state[select.name] = select.value
      apply()
    })
  })
  section.querySelectorAll('[data-reset]').forEach(function (button) { button.addEventListener('click', clear) })

  function place() {
    if (mobile.matches) drawerBody.appendChild(panel)
    else {
      slot.appendChild(panel)
      if (drawer.open) drawer.close()
    }
  }
  function close() {
    drawer.close()
  }
  openButton.addEventListener('click', function () {
    drawer.showModal()
    document.documentElement.style.overflow = 'hidden'
  })
  drawer.addEventListener('close', function () {
    document.documentElement.style.overflow = ''
    openButton.focus()
  })
  drawer.querySelector('.recipes__close').addEventListener('click', close)
  // Tik naast het paneel (op de achtergrond) sluit ook.
  drawer.addEventListener('click', function (event) { if (event.target === drawer) close() })
  showButton.addEventListener('click', function () {
    close()
    grid.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
  })
  mobile.addEventListener('change', place)
  place()

  // Beginstand uit de URL; onbekende waarden negeren.
  var params = new URLSearchParams(location.search)
  var course = params.get('gang') || ''
  if ([].some.call(buttons, function (b) { return b.dataset.course === course })) state.gang = course
  selects.forEach(function (select) {
    var value = params.get(select.name) || ''
    if ([].some.call(select.options, function (o) { return o.value === value })) state[select.name] = value
  })
  apply()
  filters.hidden = false
})
</script>

<style>
/* Thema-strook: helemaal naar links tot de laatste kaart aan de rechterrand staat. De zichtbare
   breedte is de breedte van main (max. de paginabreedte). */
@keyframes recipes-drawer {
  from { transform: translateY(100%); }
}
@keyframes recipes-backdrop {
  from { opacity: 0; }
}
@keyframes recipes-rail {
  to { transform: translateX(calc(-100% + min(100vw, var(--steva-pagina-breedte)))); }
}
/* Alles onder de kop is conditioneel en dus in de frontmatter opgebouwd — genest onder de
   gescopete main (zie RecipeCard.wald). */
.recipes {
  max-width: var(--steva-pagina-breedte);
  margin: 0 auto;
  padding: var(--byz-space-12) var(--steva-pagina-marge) var(--byz-space-24);

  /* Kerncijfers */
  & .recipes__stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--byz-space-4) var(--byz-space-12);
    margin: calc(-1 * var(--byz-space-4)) 0 var(--byz-space-16);
  }
  & .recipes__stats div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
  }
  & .recipes__stats dd {
    margin: 0;
    color: var(--byz-color-text-primary);
    font-size: var(--byz-text-4xl);
    font-weight: var(--byz-font-semibold);
    line-height: 1;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & .recipes__stats dt {
    color: var(--byz-color-accent);
    font-family: var(--steva-font-script);
    font-size: var(--byz-text-lg);
  }

  /* Koppen van de secties */
  & .recipes__themes {
    margin-top: var(--byz-space-20);
  }
  /* "Blader door alles": meer lucht erboven en tussen de kop en de filters. */
  & .recipes__all {
    margin-top: var(--byz-space-24);
  }
  & .recipes__all .recipes__section-head {
    margin-bottom: var(--byz-space-12);
  }
  & .recipes__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--byz-space-2) var(--byz-space-6);
    margin-bottom: var(--byz-space-8);
  }
  & .recipes__heading {
    margin: 0;
    font-size: var(--byz-text-2xl);
    font-weight: var(--byz-font-semibold);
    line-height: 1.23;
    letter-spacing: 0;
    text-transform: uppercase;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & .recipes__more {
    color: var(--byz-color-text-secondary);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    text-decoration: none;
  }
  & .recipes__more:hover {
    color: var(--byz-color-text-primary);
  }

  /* Thema-strook: horizontaal scrollen met snap; loopt door tot de rand van het scherm. */
  & .recipes__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 18rem);
    gap: var(--byz-space-4);
    margin: 0 calc(-1 * var(--steva-pagina-marge));
    /* Ruimte boven voor de tabjes: overflow-x: auto knipt ook verticaal af. */
    padding: var(--byz-space-6) var(--steva-pagina-marge) var(--byz-space-6);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--steva-pagina-marge);
    scrollbar-width: none;
    list-style: none;
  }
  & .recipes__rail::-webkit-scrollbar {
    display: none;
  }
  /* Browsers met scroll-driven animations (Chrome, Edge, Safari 26), vanaf tablet: de strook
     blijft staan terwijl je naar beneden scrolt en de thema's schuiven horizontaal voorbij.
     De sectie is hoger dan het scherm; die extra hoogte is de "scrollweg" van de strook.
     Anders (en bij minder beweging): gewoon horizontaal swipen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
      & .recipes__themes {
        height: 260vh;
        view-timeline-name: --themas;
      }
      & .recipes__themes-sticky {
        position: sticky;
        top: 6rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: calc(100vh - 6rem);
        /* Tot de rand van main afknippen, niet tot de binnenrand: anders verdwijnen de
           kaarten al bij de paginamarge. */
        margin-inline: calc(-1 * var(--steva-pagina-marge));
        padding-inline: var(--steva-pagina-marge);
        overflow-x: clip;
      }
      & .recipes__rail {
        width: max-content;
        overflow: visible;
        scroll-snap-type: none;
        animation: recipes-rail linear both;
        animation-timeline: --themas;
        animation-range: contain 0% contain 100%;
      }
    }
  }
  & .recipes__rail li {
    scroll-snap-align: start;
  }
  /* Als tabbladen in een receptenbak: een tabje links boven, papierachtige rand. */
  & .recipes__theme {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--byz-space-6);
    border-radius: 0.75rem;
    background:
      linear-gradient(160deg, rgb(140 35 14 / 0.9), rgb(67 11 0 / 0.9)),
      url("/images/hero-textuur.webp") center / cover;
    background-blend-mode: normal, multiply;
    box-shadow: 6px 6px 16px rgb(0 0 0 / 0.25), inset 0 0 0 1px var(--byz-color-border);
    color: var(--byz-color-text-primary);
    text-decoration: none;
    transition: transform var(--byz-duration-normal) var(--byz-ease-default), box-shadow var(--byz-duration-normal);
  }
  & .recipes__theme::before {
    content: "";
    position: absolute;
    bottom: 100%;
    left: 1.25rem;
    width: 42%;
    height: 0.9rem;
    border-radius: 0.5rem 0.5rem 0 0;
    background: rgb(140 35 14 / 0.95);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), inset 1px 0 0 var(--byz-color-border), inset -1px 0 0 var(--byz-color-border);
  }
  & .recipes__rail li:nth-child(3n + 2) .recipes__theme::before {
    left: 29%;
  }
  & .recipes__rail li:nth-child(3n) .recipes__theme::before {
    left: auto;
    right: 1.25rem;
  }
  & .recipes__theme:hover {
    transform: translateY(-4px);
    box-shadow: 6px 10px 20px rgb(0 0 0 / 0.3), inset 0 0 0 1px var(--byz-color-accent);
  }
  & .recipes__theme-count {
    color: var(--byz-color-accent);
    font-size: var(--byz-text-4xl);
    font-weight: var(--byz-font-semibold);
    line-height: 1;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & .recipes__theme-title {
    margin: var(--byz-space-3) 0 var(--byz-space-2);
    font-size: var(--byz-text-lg);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & .recipes__theme-text {
    color: var(--byz-color-text-muted);
    font-size: var(--byz-text-sm);
    line-height: var(--byz-leading-relaxed);
  }

  /* Filters */
  /* Lucht tussen de gang-knoppen, de keuzelijsten en het aantal. */
  & .recipes__filters {
    display: grid;
    gap: var(--byz-space-8);
    margin-bottom: var(--byz-space-10);
  }
  & .recipes__filters[hidden],
  & [data-cuisine][hidden],
  & .recipes__none[hidden] {
    display: none;
  }
  & .recipes__courses {
    display: flex;
    flex-wrap: wrap;
    gap: var(--byz-space-2);
  }
  & .recipes__courses button {
    padding: var(--byz-space-2) var(--byz-space-5);
    border: 0;
    border-radius: 999px;
    background: rgb(67 11 0 / 0.55);
    box-shadow: inset 0 0 0 1px var(--byz-color-border);
    color: var(--byz-color-text-secondary);
    font-size: var(--byz-text-sm);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    cursor: pointer;
  }
  & .recipes__courses button[aria-pressed="true"] {
    background: var(--byz-color-accent);
    box-shadow: inset 0 -3px 0 var(--steva-oranje-donker);
    color: var(--steva-bordeaux-donker);
  }
  & .recipes__slot .recipes__panel {
    display: grid;
    gap: var(--byz-space-8);
  }
  & .recipes__selects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    gap: var(--byz-space-3) var(--byz-space-4);
  }
  & .recipes__filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--byz-space-4);
  }
  & .recipes__select {
    display: flex;
    flex-direction: column;
    gap: var(--byz-space-1);
    color: var(--byz-color-text-secondary);
    font-size: var(--byz-text-sm);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
  }
