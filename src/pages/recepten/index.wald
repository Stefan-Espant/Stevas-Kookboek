  /* De drawer: schuift van onderen in beeld, maximaal 85% van het scherm hoog. */
  & .recipes__drawer {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: 100%;
    /* Vaste hoogte (niet alleen max-height): dan krijgt het middendeel altijd ruimte. */
    height: min(34rem, 90vh);
    height: min(34rem, calc(100dvh - 2.5rem));
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
