---
import Layout from '../../layouts/Layout.wald'
---
<Layout title="Je bent ingeschreven" noindex={true} fullHeight={true}>
  <main class="newsletter-status">
    <h1 class="newsletter-status__title">Je bent ingeschreven</h1>
    <p>Welkom! Je staat op de lijst voor Steva's nieuwsbrief. Binnenkort vind je de eerste recepten in je mail. Tot die tijd: kijk alvast rond in het kookboek.</p>
    <a href="/recepten">Naar alle recepten</a>
  </main>
</Layout>

<style>
/* Zelfde opbouw als de 404-pagina. */
.newsletter-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: var(--byz-space-4);
  padding: clamp(var(--byz-space-4), 5vw, var(--byz-space-8));
}
.newsletter-status p {
  max-width: 52ch;
  line-height: var(--byz-leading-relaxed);
}
.newsletter-status__title {
  overflow-wrap: break-word;
  hyphens: auto;
  font-size: var(--byz-text-3xl);
  font-weight: var(--byz-font-semibold);
  letter-spacing: 0;
  text-transform: uppercase;
  text-shadow: var(--steva-tekst-schaduw);
}
.newsletter-status a {
  background: var(--byz-color-accent);
  box-shadow: inset 0 -4px 0 var(--steva-oranje-donker);
  color: var(--steva-bordeaux-donker);
  font-weight: var(--byz-font-semibold);
  text-transform: uppercase;
  border-radius: 0.375rem;
  padding: var(--byz-space-2) var(--byz-space-5);
  text-decoration: none;
}
</style>
