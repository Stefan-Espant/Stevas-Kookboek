---
import Layout from '../layouts/Layout.wald'
import PageHeader from '../components/PageHeader.wald'
import RecipeGrid from '../components/RecipeGrid.wald'
import { getCollections } from '../lib/recipes'
import { breadcrumbSchema, clipDescription } from '../lib/site'
const collections = await getCollections()
const lead = 'Geen idee wat je vanavond kookt? Blader door de thema\'s en laat je verrassen.'
const description = clipDescription(`Inspiratie voor vandaag: ${collections.map(c => c.title.toLowerCase()).join(', ')}. ${lead}`)
const schema = [breadcrumbSchema([['Home', '/'], ['Inspiratie', '/inspiratie']])]

// Thema's worden automatisch gevuld op basis van bereidingstijd en tags (zie getCollections).
const navHtml = collections.length > 1
  ? renderTemplate`<nav class="inspiration__nav" aria-label="Thema's">${new SafeHtml(collections.map(c => renderTemplate`<a href="#${c.slug}">${c.title}</a>`).join(''))}</nav>`
  : ''
const sections = await Promise.all(collections.map(async (collection) => renderTemplate`
  <section class="inspiration__section" id="${collection.slug}" aria-labelledby="${collection.slug}-titel">
    <h2 class="inspiration__title" id="${collection.slug}-titel">${collection.title}</h2>
    <p class="inspiration__description">${collection.description}</p>
    ${new SafeHtml(await RecipeGrid.render({ recipes: collection.recipes }))}
  </section>`))
const sectionsHtml = sections.length
  ? sections.join('')
  : '<p class="inspiration__empty">Binnenkort verschijnen hier de eerste thema\'s!</p>'
---
<Layout title="Inspiratie: wat eten we vandaag?" description={description} path="/inspiratie" schema={schema}>
  <main class="inspiration">
    <PageHeader kicker="Inspiratie" title="Wat eten we vandaag?" lead={lead} />
    {new SafeHtml(navHtml)}
    {new SafeHtml(sectionsHtml)}
  </main>
</Layout>

<style>
/* Navigatie, secties en lege staat zijn in de frontmatter opgebouwd — genest onder de gescopete main. */
.inspiration {
  max-width: var(--steva-pagina-breedte);
  margin: 0 auto;
  padding: var(--byz-space-12) var(--steva-pagina-marge) var(--byz-space-24);

  & .inspiration__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--byz-space-2);
    margin-bottom: var(--byz-space-16);
  }
  & .inspiration__nav a {
    padding: var(--byz-space-2) var(--byz-space-5);
    border-radius: 999px;
    background: rgb(67 11 0 / 0.55);
    box-shadow: inset 0 0 0 1px var(--byz-color-border);
    color: var(--byz-color-text-secondary);
    font-size: var(--byz-text-sm);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    text-decoration: none;
  }
  & .inspiration__nav a:hover {
    background: var(--byz-color-accent);
    color: var(--steva-creme);
  }
  & .inspiration__section {
    /* Ruimte voor de sticky header bij springen naar een anker. */
    scroll-margin-top: calc(6rem + var(--byz-space-6));
  }
  & .inspiration__section + .inspiration__section {
    margin-top: var(--byz-space-20);
  }
  & .inspiration__title {
    font-size: var(--byz-text-2xl);
    font-weight: var(--byz-font-semibold);
    line-height: 1.23;
    letter-spacing: 0;
    text-transform: uppercase;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & .inspiration__description {
    max-width: 62ch;
    margin: var(--byz-space-2) 0 var(--byz-space-8);
    color: var(--byz-color-text-muted);
  }
  & .inspiration__empty {
    color: var(--byz-color-text-secondary);
    font-family: var(--steva-font-script);
    font-size: var(--byz-text-xl);
    text-align: center;
  }
}
</style>
