---
import Layout from '../layouts/Layout.wald'
---
<Layout title="Pagina niet gevonden" noindex={true}>
  <main class="cms-error">
    <h1 class="cms-error__title">Pagina niet gevonden</h1>
    <p>Deze pagina bestaat niet (meer). Misschien vind je wat je zoekt bij de recepten.</p>
    <a href="/recepten">Naar alle recepten</a>
  </main>
</Layout>

<style>
.cms-error {
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: var(--byz-space-4);
  padding: var(--byz-space-8);
}
.cms-error__title {
  font-size: var(--byz-text-3xl);
  font-weight: var(--byz-font-semibold);
  letter-spacing: 0;
  text-transform: uppercase;
  text-shadow: var(--steva-tekst-schaduw);
}
.cms-error a {
  background: var(--byz-color-accent);
  box-shadow: inset 0 -4px 0 var(--steva-oranje-donker);
  color: var(--steva-bordeaux-donker);
  font-weight: var(--byz-font-semibold);
  text-transform: uppercase;
  border-radius: 0.375rem;
  padding: var(--byz-space-2) var(--byz-space-5);
  text-decoration: none;
}
</style>
