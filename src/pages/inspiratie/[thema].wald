---
import Layout from '../../layouts/Layout.wald'
import PageHeader from '../../components/PageHeader.wald'
import RecipeGrid from '../../components/RecipeGrid.wald'
import Breadcrumbs from '../../components/Breadcrumbs.wald'
import { collectionPath, getCollections, recipePath } from '../../lib/recipes'
import { breadcrumbSchema, clipDescription, collectionSchema } from '../../lib/site'
type Props = { thema: string }
// Eén pagina per inspiratie-thema (airfryer, vegan, goedkoop, …): een vindbare landingspagina
// voor precies die zoekopdracht, automatisch gevuld via de regels in getCollections().
export async function getStaticPaths() {
  const collections = await getCollections()
  return collections.map(collection => ({ params: { thema: collection.slug } }))
}
const collections = await getCollections()
const collection = collections.find(c => c.slug === $$props.thema)
// Alleen bereikbaar in `wald grow`; de build rendert alleen thema's met recepten.
if (!collection) throw new Error(`Thema "${$$props.thema}" heeft geen recepten`)

const count = collection.recipes.length
const path = collectionPath(collection.slug)
const lead = `${collection.description} ${count} ${count === 1 ? 'recept' : 'recepten'}.`
// Recepttitels in de omschrijving: precies waar mensen op zoeken.
const description = clipDescription(`${collection.seoTitle}: ${collection.recipes.map(r => r.title).join(', ')}. Met ingrediënten, bereiding en tips.`)
const crumbs: Array<[string, string]> = [['Home', '/'], ['Inspiratie', '/inspiratie'], [collection.title, path]]
const schema = [
  breadcrumbSchema(crumbs),
  collectionSchema(collection.seoTitle, description, path, collection.recipes.map(r => [r.title, recipePath(r.slug)]))
]
const breadcrumbs = await Breadcrumbs.render({ items: crumbs })
const grid = await RecipeGrid.render({ recipes: collection.recipes, headingLevel: 2, eager: 1, balanced: collection.slug === 'halloween' })

// Andere thema's als interne links onderaan.
const others = collections.filter(c => c.slug !== collection.slug)
// Seizoenseffect: vallende bladeren op de herfstpagina (public/leaves.js), vleermuizen op de
// Halloweenpagina (public/halloween.js); beide geladen door motion.js.
const isHalloween = collection.slug === 'halloween'
const seasonEffect = collection.slug === 'herfst' || isHalloween ? collection.slug : undefined

// Halloween: spinnenweb in de hoeken (een kwart web, gespiegeld voor rechts), een spin aan een draad
// en mist onderin. Puur decoratief (aria-hidden); bij "minder beweging" staan de animaties stil.
function web(): string {
  const spokes = [0, 16, 33, 50, 67, 84, 100].map(p => (p / 100) * Math.PI / 2)
  const point = (a: number, r: number) => [Math.sin(a) * r, Math.cos(a) * r].map(n => n.toFixed(1))
  const lines = spokes.map(a => `M0 0 L${point(a, 200).join(' ')}`)
  const rings = [40, 75, 112, 150, 188].map(r => 'M' + spokes.map((a, i) => {
    if (i === 0) return point(a, r).join(' ')
    const mid = (spokes[i - 1] + a) / 2
    return `Q${point(mid, r * 0.86).join(' ')} ${point(a, r).join(' ')}`
  }).join(' '))
  return `<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">${[...lines, ...rings].map(d => `<path d="${d}"/>`).join('')}</svg>`
}
const spider = '<svg viewBox="0 0 60 50" fill="currentColor"><ellipse cx="30" cy="22" rx="9" ry="11"/><circle cx="30" cy="36" r="7"/><circle cx="27" cy="35" r="1.4" fill="#ff8a1f"/><circle cx="33" cy="35" r="1.4" fill="#ff8a1f"/>'
  + [[-1, 14], [-1, 20], [-1, 26], [-1, 31], [1, 14], [1, 20], [1, 26], [1, 31]].map(([s, y], i) => `<path d="M${30 + s * 6} ${y} q${s * 12} ${-8 + (i % 4) * 4} ${s * 22} ${2 + (i % 4) * 5}" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round"/>`).join('')
  + '</svg>'
const decorHtml = isHalloween
  ? `<div class="hw-decor" aria-hidden="true"><div class="hw-web hw-web--links">${web()}</div><div class="hw-web hw-web--rechts">${web()}</div><div class="hw-spider"><span class="hw-spider__draad"></span>${spider}</div></div><div class="hw-fog" aria-hidden="true"></div>`
  : ''
const othersHtml = others.length
  ? renderTemplate`<nav class="theme__others" aria-labelledby="andere-themas"><h2 id="andere-themas">Meer inspiratie</h2><ul>${new SafeHtml(others.map(c => renderTemplate`<li><a href="${collectionPath(c.slug)}">${c.title}</a></li>`).join(''))}</ul></nav>`
  : ''
---
<Layout title={collection.seoTitle} description={description} path={path} schema={schema}>
  <main class={isHalloween ? 'theme theme--halloween' : 'theme'} data-season-effect={seasonEffect}>
    {new SafeHtml(decorHtml)}
    {new SafeHtml(breadcrumbs)}
    <PageHeader kicker={isHalloween ? 'Als je durft…' : 'Inspiratie'} title={collection.title} lead={lead} />
    {new SafeHtml(grid)}
    {new SafeHtml(othersHtml)}
  </main>
</Layout>

<style>
/* Griezelletter voor de Halloweenpagina (Creepster, SIL Open Font License). */
@font-face { font-family: 'Creepster'; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/creepster-latin.woff2) format('woff2'); }

/* "Meer inspiratie" is in de frontmatter opgebouwd — genest onder de gescopete main. */
.theme {
  max-width: var(--steva-pagina-breedte);
  margin: 0 auto;
  padding: var(--byz-space-12) var(--steva-pagina-marge) var(--byz-space-24);

  & .theme__others {
    margin-top: var(--byz-space-20);
    text-align: center;
  }
  & .theme__others h2 {
    margin-bottom: var(--byz-space-6);
    font-size: var(--byz-text-2xl);
    font-weight: var(--byz-font-semibold);
    line-height: 1.23;
    letter-spacing: 0;
    text-transform: uppercase;
    text-shadow: var(--steva-tekst-schaduw);
  }
  & .theme__others ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--byz-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  & .theme__others a {
    display: inline-block;
    padding: var(--byz-space-2) var(--byz-space-5);
    border-radius: 999px;
    background: rgb(67 11 0 / 0.55);
    box-shadow: inset 0 0 0 1px var(--byz-color-border);
    color: var(--byz-color-text-secondary);
    font-size: var(--byz-text-sm);
    font-weight: var(--byz-font-semibold);
    text-transform: uppercase;
    text-decoration: none;
  }
  & .theme__others a:hover {
    background: var(--byz-color-accent);
    color: var(--steva-bordeaux-donker);
  }
}

/* ── Halloween: donker, kaarslicht, mist, spinnenweb en een titel als een kapotte lamp ───────── */
.theme.theme--halloween {
  --hw-oranje: #ff8a1f;
  position: relative;
  /* Kaarten bijna zwart in plaats van bordeaux: RecipeCard gebruikt --byz-color-surface, het
     gebalanceerde raster (RecipeGrid) --steva-bordeaux-donker. */
  --byz-color-surface: #150402;
  --steva-bordeaux-donker: #150402;

  /* Bijna zwart over de hele pagina, met een flakkerende kaarsgloed achter de titel. */
  &::before,
  &::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  &::before {
    background: radial-gradient(ellipse 110% 85% at 50% 40%, rgb(12 3 1 / 0.72), rgb(4 1 0 / 0.95) 75%);
  }
  &::after {
    background: radial-gradient(ellipse 55% 35% at 50% 18%, rgb(255 120 20 / 0.24), transparent 70%);
    animation: hw-kaars 3.2s infinite;
  }

  & .page-header__kicker {
    color: var(--hw-oranje);
  }
  & .page-header__title {
    font-family: 'Creepster', var(--byz-font-serif);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--hw-oranje);
    text-shadow: 0 0 18px rgb(255 120 20 / 0.65), 0 0 60px rgb(255 60 0 / 0.35);
    animation: hw-lamp 7s infinite;
  }

  & .recipe-card {
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  & .recipe-card:hover,
  & .recipe-card:focus-visible {
    box-shadow: 0 0 0 1px rgb(255 138 31 / 0.65), 0 0 42px rgb(255 100 0 / 0.38);
    animation: hw-huiver 0.35s ease-in-out;
  }
  /* Zaklamp: met een muis staan de foto's gedimd in het donker en lichten ze op als je eroverheen
     gaat. Op touchscreens (geen hover) blijven ze gewoon helder. */
  @media (hover: hover) {
    & .recipe-card__image {
      filter: brightness(0.62) saturate(0.85);
      transition: filter 0.35s ease;
    }
    & .recipe-card:hover .recipe-card__image,
    & .recipe-card:focus-visible .recipe-card__image {
      filter: none;
    }
  }
  & .theme__others a {
    box-shadow: inset 0 0 0 1px rgb(255 138 31 / 0.45);
  }

  & .hw-decor {
    position: absolute;
    inset: 0 0 auto;
    height: 0;
    color: rgb(252 246 234 / 0.28);
    pointer-events: none;
  }
  & .hw-web {
    position: absolute;
    top: calc(-1 * var(--byz-space-12));
    width: clamp(110px, 18vw, 240px);
  }
  & .hw-web--links { left: calc(-1 * var(--steva-pagina-marge)); }
  & .hw-web--rechts { right: calc(-1 * var(--steva-pagina-marge)); transform: scaleX(-1); }
  & .hw-spider {
    position: absolute;
    top: calc(-1 * var(--byz-space-12));
    right: clamp(70px, 12vw, 190px);
    width: clamp(34px, 4vw, 52px);
    color: #120302;
    animation: hw-zakken 8s ease-in-out infinite;
    transform-origin: 50% 0;
  }
  & .hw-spider__draad {
    position: absolute;
    bottom: 80%;
    left: 50%;
    width: 1px;
    height: 100vh;
    background: rgb(252 246 234 / 0.35);
  }
  & .hw-spider svg {
    position: relative;
    filter: drop-shadow(0 0 6px rgb(255 120 20 / 0.45));
  }
  /* Mist die langzaam onderin het scherm voorbij trekt. */
  & .hw-fog {
    position: fixed;
    inset: auto 0 0;
    z-index: -1;
    height: 38vh;
    pointer-events: none;
    background:
      radial-gradient(ellipse 40% 60% at 20% 100%, rgb(170 160 190 / 0.16), transparent 70%),
      radial-gradient(ellipse 45% 55% at 70% 100%, rgb(170 160 190 / 0.13), transparent 70%),
      radial-gradient(ellipse 30% 50% at 95% 100%, rgb(170 160 190 / 0.12), transparent 70%);
    background-size: 160% 100%;
    animation: hw-mist 26s ease-in-out infinite alternate;
  }
}
@keyframes hw-kaars {
  0%, 100% { opacity: 1; }
  12% { opacity: 0.82; }
  20% { opacity: 0.95; }
  41% { opacity: 0.7; }
  47% { opacity: 1; }
  73% { opacity: 0.86; }
}
@keyframes hw-lamp {
  0%, 17%, 21%, 60%, 63%, 100% { opacity: 1; }
  18% { opacity: 0.3; }
  20% { opacity: 0.85; }
  61% { opacity: 0.5; }
}
@keyframes hw-huiver {
  20% { transform: translate(-1px, 1px) rotate(-0.4deg); }
  40% { transform: translate(1px, -1px) rotate(0.4deg); }
  60% { transform: translate(-1px, 0) rotate(-0.2deg); }
  80% { transform: translate(1px, 1px) rotate(0.2deg); }
}
@keyframes hw-zakken {
  0%, 100% { transform: translateY(0); }
  45% { transform: translateY(clamp(70px, 14vw, 170px)) rotate(4deg); }
  55% { transform: translateY(clamp(64px, 13vw, 160px)) rotate(-3deg); }
}
@keyframes hw-mist {
  to { background-position: 100% 0; }
}
@media (prefers-reduced-motion: reduce) {
  .theme.theme--halloween {
    &::after,
    & .page-header__title,
    & .hw-spider,
    & .hw-fog,
    & .recipe-card:hover,
    & .recipe-card:focus-visible {
      animation: none;
    }
  }
}
</style>
